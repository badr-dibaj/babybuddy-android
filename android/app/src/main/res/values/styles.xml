<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. Since UI is handled entirely by Slint,
         we use a no-action-bar style. Theme.AppCompat.NoActionBar is provided
         by the appcompat library and works with all modern Android versions.
         android:Theme.Material.NoTitleBar.Fullscreen was removed in SDK 34. -->
    <style name="Theme.BabyBuddy" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowFullscreen">false</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>
</resources>
