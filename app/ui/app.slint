            text: "Diaper Changes";
            font-size: Theme.headline-s;
            font-weight: 700;
            color: Theme.on-surface;
        }

        if diapers.length == 0 : Rectangle {
            height: 200px;
            VerticalLayout {
                alignment: center;
                spacing: Theme.space-m;
                Text { text: "🩹"; font-size: 48px; horizontal-alignment: center; }
                Text {
                    text: "No diapers recorded yet.\nTap + to add one!";
                    font-size: Theme.body-m;
                    color: Theme.on-surface-variant;
                    horizontal-alignment: center;
                }
            }
        }

        for d in diapers : Card {
            height: 76px;

            HorizontalLayout {
                padding-left: Theme.space-m;
                padding-right: Theme.space-s;
